#: .\nu_quran_api\exceptions.py:15
#, python-format
msgid "No %(name)s matches the given query."
msgstr "لم يتم العثور على %(name)s يطابق الاستعلام المحدد."

msgid "User"
msgstr "مستخدم"

msgid "Goal"
msgstr "هدف"

msgid "Category"
msgstr "فئة"

msgid "Activity"
msgstr "نشاط"

msgid "Group"
msgstr "مجموعة"

msgid "Token is invalid or expired"
msgstr "الرمز غير صالح أو منتهي الصلاحية"

msgid "No active account found with the given credentials"
msgstr "لم يتم العثور على حساب نشط ببيانات الاعتماد المقدمة"

msgid "Authentication credentials were not provided."
msgstr "لم يتم توفير بيانات اعتماد المصادقة."

msgid "You do not have permission to perform this action."
msgstr "ليس لديك الإذن لأداء هذا الإجراء."

msgid "This field is required."
msgstr "هذا الحقل مطلوب."

msgid "Enter a valid email address."
msgstr "أدخل عنوان بريد إلكتروني صالح."

msgid "This field must be unique."
msgstr "يجب أن يكون هذا الحقل فريداً."

msgid "Enter a valid value."
msgstr "أدخل قيمة صالحة."

msgid "Invalid input."
msgstr "مدخل غير صالح."
